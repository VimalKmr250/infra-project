# Copy to .env and fill in. .env is gitignored and must never be committed.
# Used by docker compose locally and on the Raspberry Pi.

# --- Database ---
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- pgAdmin (local profile only) ---
PGADMIN_EMAIL=dev@local.test
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Application ---
# HS256 signing key. Generate a real one with:
#   openssl rand -base64 48
APP_JWT_SECRET=dev-only-secret-at-least-32-bytes-long-change-me
APP_JWT_EXPIRY=PT1H
APP_JWT_REFRESH_EXPIRY=P7D

# --- Pi / QA only ---
# ghcr.io/<owner>/<repo>
IMAGE=ghcr.io/OWNER/REPO:qa
# Named tunnel token from the Cloudflare dashboard.
# Leave EMPTY to use a quick tunnel (free, no domain, URL changes on restart).
CLOUDFLARE_TUNNEL_TOKEN=
