# Copy to .env on the Pi:  cp .env.example .env  &&  chmod 600 .env
# Never commit the filled-in version.

# Image to run. Set OWNER/REPO to your GitHub repository (lowercase).
IMAGE=ghcr.io/OWNER/REPO:qa

# Database
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Application. Generate with: openssl rand -base64 48
APP_JWT_SECRET=

# Leave EMPTY for a free quick tunnel (random *.trycloudflare.com URL that
# changes on every restart). Set it to a named-tunnel token once you have a
# domain on Cloudflare, and deploy.sh will switch profiles automatically.
CLOUDFLARE_TUNNEL_TOKEN=

# GHCR read credentials, used by bootstrap.sh to log Docker in.
GHCR_USER=
GHCR_TOKEN=
