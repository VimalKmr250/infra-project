# Normalise every text file to LF inside the repository.
#
# This is not cosmetic. gradlew and everything under infra/pi run on Linux - the
# Raspberry Pi, CI runners, and inside the Docker build. A script committed with
# CRLF fails there with "bad interpreter: /bin/bash^M", and the systemd units
# that invoke deploy.sh and backup.sh fail on every fire.
* text=auto eol=lf

# Windows-only launchers must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never line-ending-convert binaries.
*.jar   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.woff  binary
*.woff2 binary
